# agents.env — shared model defaults for the orchestra scripts in this directory.
#
# Every script sources this file if it exists. Precedence:
#   CLI flag  >  exported ORCHESTRA_* env var  >  this file  >  in-script fallback
#
# Bump models here once instead of editing each script.
#
# The ORCHESTRA_ prefix is deliberate: Claude Code exports CLAUDE_EFFORT (and may
# export CLAUDE_MODEL) into every child process, so unprefixed names would make
# these scripts silently inherit the parent session's settings instead of theirs.

# ── OpenAI Codex (codex exec / codex exec review) ────────────────────
: "${ORCHESTRA_CODEX_MODEL:=gpt-5.6-sol}"
: "${ORCHESTRA_CODEX_EFFORT:=high}"   # minimal | low | medium | high | xhigh  (model_reasoning_effort)

# ── Claude Code (claude -p) ──────────────────────────────────────────
# "opus" is an alias that always resolves to the latest frontier Opus.
# Use "opus[1m]" for the 1M-context variant on very large diffs.
: "${ORCHESTRA_CLAUDE_MODEL:=opus}"
: "${ORCHESTRA_CLAUDE_EFFORT:=high}"  # low | medium | high | xhigh | max
