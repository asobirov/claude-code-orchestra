#!/bin/bash
# codex-validate — Run Codex with a custom prompt against the codebase (separate context)
# Usage:
#   codex-validate "check if the API routes handle auth correctly"
#   codex-validate "run the tests and report failures"
#   echo "context" | codex-validate "analyze this"
#
# Runs in read-only sandbox by default. Pass --full-auto for write access.
# Model/effort: --codex-model <id> / --codex-effort <level> (see agents.env).

set -euo pipefail

# Resolve this script's dir BEFORE cd'ing — $0 may be a relative path
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$REPO_ROOT" ]; then echo "Not in a git repository." >&2; exit 1; fi
cd "$REPO_ROOT"

OUTPUT_FILE=$(mktemp /tmp/codex-validate-XXXXXX)
ERR_FILE=$(mktemp /tmp/codex-validate-err-XXXXXX)  # own mktemp; trailing X's only (BSD)
# Trap immediately: arg parsing below can exit via ${2:?...} before the final rm
cleanup() { rm -f "$OUTPUT_FILE" "$ERR_FILE"; }
trap cleanup EXIT

# Shared model defaults — see agents.env; ORCHESTRA_* env vars override it, flags override those
if [ -f "$SCRIPT_DIR/agents.env" ]; then . "$SCRIPT_DIR/agents.env"; fi
CODEX_MODEL="${ORCHESTRA_CODEX_MODEL:-gpt-5.6-sol}"
CODEX_EFFORT="${ORCHESTRA_CODEX_EFFORT:-high}"

PROMPT=""
EXTRA_ARGS=()
SANDBOX="read-only"

# Model/effort are consumed here rather than forwarded — codex rejects a repeated
# --model, so passing our default plus the caller's would be a usage error.
while [ $# -gt 0 ]; do
  case "$1" in
    --full-auto)
      SANDBOX="workspace-write"; shift ;;
    --sandbox)
      SANDBOX="${2:?--sandbox requires a value}"; shift 2 ;;
    --codex-model|--model|-m)
      CODEX_MODEL="${2:?$1 requires a value}"; shift 2 ;;
    --codex-effort)
      CODEX_EFFORT="${2:?$1 requires a value}"; shift 2 ;;
    -o|--output-last-message|--ephemeral)
      # this wrapper owns these; forwarding them would duplicate the flag
      echo "$1 is managed by codex-validate and cannot be overridden" >&2; exit 2 ;;
    -*)
      EXTRA_ARGS+=("$1"); shift ;;
    *)
      if [ -z "$PROMPT" ]; then PROMPT="$1"; else EXTRA_ARGS+=("$1"); fi
      shift ;;
  esac
done

if [ -z "$PROMPT" ]; then
  echo "Usage: codex-validate \"<prompt>\" [--full-auto] [extra codex flags...]"
  exit 1
fi

# The ${arr[@]+...} guard is required: bash 3.2 treats an empty array as unset under `set -u`.
RC=0
codex exec \
  --model "$CODEX_MODEL" \
  -c model_reasoning_effort="$CODEX_EFFORT" \
  --sandbox "$SANDBOX" \
  --ephemeral \
  --output-last-message "$OUTPUT_FILE" \
  ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} \
  "$PROMPT" >/dev/null 2>"$ERR_FILE" || RC=$?

if [ -s "$OUTPUT_FILE" ]; then
  cat "$OUTPUT_FILE"
  if [ "$RC" -ne 0 ]; then echo "codex exited $RC after writing output" >&2; fi
else
  echo "Codex produced no output." >&2
  if [ -s "$ERR_FILE" ]; then tail -5 "$ERR_FILE" >&2; fi
  if [ "$RC" -eq 0 ]; then RC=1; fi
fi
exit "$RC"
